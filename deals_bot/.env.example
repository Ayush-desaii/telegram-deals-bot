# ============================================================
#  FILL IN YOUR DETAILS BELOW
#  Then rename this file to .env
# ============================================================

# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your channel username (with @) or numeric channel ID
# Example: @MyLootDeals  OR  -1001234567890
TELEGRAM_CHANNEL_ID=@YourChannelUsername

# Amazon Associates affiliate tag (e.g.  yourname-21)
# Sign up free: https://affiliate-program.amazon.in/
AMAZON_AFFILIATE_TAG=yourtag-21

# ── Amazon PA API (for unlimited fresh product data with images) ──
# Get these from: https://affiliate-program.amazon.in/assoc_credentials/home
# Note: Requires 3+ qualifying sales to unlock API access
AMAZON_PA_API_KEY=your_pa_api_key_here
AMAZON_PA_API_SECRET=your_pa_api_secret_here

# How often to fetch & post deals (in minutes)
FETCH_INTERVAL_MINUTES=60

# Only post deals with THIS much discount or more (in %)
MIN_DISCOUNT_PERCENT=40

# Max deals to post per fetch cycle (to avoid spamming)
MAX_DEALS_PER_CYCLE=3
